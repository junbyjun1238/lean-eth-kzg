{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junbyjun1238/lean-eth-kzg/blob/main/corpus/adversarial/case.schema.json",
  "title": "lean-eth-kzg adversarial case",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "status",
    "source",
    "api",
    "family",
    "invariants",
    "summary",
    "input",
    "expected",
    "tag_matrix"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "status": {
      "enum": ["draft", "active", "archived"]
    },
    "source": {
      "const": "adversarial"
    },
    "api": {
      "enum": [
        "verify_kzg_proof",
        "verify_blob_kzg_proof",
        "verify_blob_kzg_proof_batch",
        "verify_cell_kzg_proof_batch"
      ]
    },
    "family": {
      "enum": [
        "threshold789",
        "duplicateCommitments",
        "pointAtInfinity",
        "malformedBytes",
        "permutationEquivalentBatches",
        "fuluCellOrdering"
      ]
    },
    "bug_class": {
      "type": ["string", "null"],
      "enum": ["pointAtInfinityFastPath", "dedupWeakFiatShamir", null]
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "invalidInputDeterminism",
          "singletonBatchConsistency",
          "batchNormalFormDeterminism",
          "challengeCanonicality",
          "fastPathNaiveAgreement",
          "uniqueCommitmentBinding"
        ]
      }
    },
    "summary": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          }
        ]
      }
    },
    "expected": {
      "type": "object",
      "required": ["normalization", "decision"],
      "properties": {
        "normalization": {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": {
              "enum": ["ok", "error"]
            },
            "error": {
              "type": "object",
              "required": ["kind", "label"],
              "properties": {
                "kind": {
                  "enum": [
                    "wrongLength",
                    "wrongVectorLength",
                    "indexOutOfBounds",
                    "invariantViolation"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "expected": {
                  "type": "integer",
                  "minimum": 0
                },
                "actual": {
                  "type": "integer",
                  "minimum": 0
                },
                "upper_bound": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "decision": {
          "enum": ["accept", "reject"]
        }
      },
      "additionalProperties": false
    },
    "tag_matrix": {
      "type": "object",
      "patternProperties": {
        "^v2\\.1\\.[2-5]$": {
          "type": "object",
          "required": ["expected_replay", "reason"],
          "properties": {
            "expected_replay": {
              "enum": ["pass", "fail"]
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
